# Optional. The server also reads the key from ~/.config/balonche/anthropic-key (mode 0600).
# ANTHROPIC_API_KEY=
# BALONCHE_PROVIDER=anthropic | claude-cli | none | fake (browser tests)
# BALONCHE_MODEL=claude-opus-5-5
# BALONCHE_EFFORT=low | medium | high  (the claude command only; low answers fastest)
# BALONCHE_CLAUDE_CONFIG_DIR=  Claude Code login folder, when the default is not the one you want
# PORT=3417
