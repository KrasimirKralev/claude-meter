{
  "name": "balonche",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "The sketch-to-map app inside Claude Meter: sketch on a dotted canvas, press Digitize, end with a finished bubble map.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "start": "vite build && node server/index.ts",
    "serve": "node server/index.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "bundle": "npm run build && node scripts/bundle.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.6.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/comfortaa": "5.3.0",
    "@fontsource/dela-gothic-one": "5.3.0",
    "@fontsource/golos-text": "5.3.0",
    "@fontsource/nunito": "5.3.0",
    "@fontsource/rubik": "5.3.0",
    "@fontsource/unbounded": "5.3.0",
    "express": "5.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@tailwindcss/vite": "4.3.5",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "rolldown": "1.2.16",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  },
  "license": "MIT"
}
