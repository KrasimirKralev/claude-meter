{
  "name": "claude-usage-widget",
  "version": "2.16.0",
  "description": "Desktop widget for Claude usage + a planner (calendar, tasks, notes, habits).",
  "main": "main.js",
  "author": "Krasimir Kralev",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/KrasimirKralev/claude-meter.git"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test test/relax.test.js test/relax-biomes.test.js test/relax-lofi.test.js test/relax-music.test.js test/login-expiry.test.js test/display-scale.test.js test/usage-limits.test.js test/maps-lib.test.js test/widget-lib.test.js test/maps-view.test.js test/plan-lib.test.js",
    "bundle:maps": "node scripts/bundle-maps.js",
    "build": "npm run bundle:maps && electron-builder",
    "build:win": "npm run bundle:maps && electron-builder --win",
    "build:mac": "npm run bundle:maps && electron-builder --mac --publish never",
    "build:linux": "npm run bundle:maps && electron-builder --linux",
    "test:maps": "npm --prefix maps run typecheck && npm --prefix maps test",
    "test:maps:install": "npm --prefix maps install --no-audit --no-fund"
  },
  "build": {
    "appId": "com.claude-usage-widget",
    "productName": "Claude Meter",
    "directories": {
      "output": "dist"
    },
    "files": [
      "*.js",
      "*.html",
      "relax-biomes/**/*",
      "!relax-biomes/samples/build-pack.py",
      "assets/**/*",
      "maps/build/**/*"
    ],
    "asarUnpack": [
      "maps/build/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": true,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "include": "build/installer.nsh"
    },
    "mac": {
      "category": "public.app-category.utilities",
      "icon": "assets/icon.png",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "identity": null
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "category": "Utility"
    },
    "publish": null
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "dependencies": {
    "chart.js": "^4.5.1"
  },
  "allowScripts": {
    "electron@33.4.11": true
  }
}
