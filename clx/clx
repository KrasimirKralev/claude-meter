# --------------------------------------------------------------------------- io


def read_json(path, default=None):
    try:
        with open(path, "r", encoding="utf-8") as fh:
            return json.load(fh)
    except Exception:
        return {} if default is None else default


def _new_tmp(path, mode):
    """A fresh temp file beside `path`: created with its final mode, never through a
    symlink, so a copy of ~/.claude.json or a login is never readable by others,
    even mid-write."""
    tmp = "%s.tmp-%d" % (path, os.getpid())
    try:
        os.unlink(tmp)  # a leftover from a killed run
    except OSError:
        pass
    return tmp, os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, mode)


def _drop(tmp):
    try:
        os.unlink(tmp)
    except OSError:
        pass


def write_json_atomic(path, obj, mode=0o600):
    tmp, fd = _new_tmp(path, mode)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as fh:
            json.dump(obj, fh, indent=2, ensure_ascii=False)
            fh.write("\n")
        os.chmod(tmp, mode)
        os.replace(tmp, path)
    except BaseException:
        _drop(tmp)
        raise


def warn(msg):
    sys.stderr.write(msg + "\n")


# ------------------------------------------------------------- desktop notice
# A hand-off is invisible to a user who is staring at "continuing automatically
# at 3:40am": nothing is printed until the session takes a turn, and a blocked
# session never takes one. This is the only channel that reaches them.
#
# Best effort in the strictest sense - it never blocks (the child is detached and
# never waited on), never raises, and never changes what the caller returns. It
# stays silent with CLX_NO_NOTIFY=1, with no notify-send on PATH, and on a tty or
# ssh session with no desktop bus.
NOTIFY_BIN = "notify-send"
NOTIFY_APP = "clx"
NOTIFY_CONTINUE = ("If this terminal is waiting on a usage limit: "
                   "press Esc, then type continue")
_NOTIFY_PROCS = []  # detached children, reaped on the next notify()


def notify(summary, body="", urgency="normal"):
    """Fire a desktop notification. -> True when one was actually spawned."""
    if os.environ.get("CLX_NO_NOTIFY"):
        return False
    if not os.environ.get("DBUS_SESSION_BUS_ADDRESS"):
        return False  # no session bus: a tty, a cron job, an ssh login
    try:
        binary = shutil.which(NOTIFY_BIN)
        if not binary:
            return False
        # --transient: a banner only, never kept in GNOME's notification list
        # (owner, 2026-10-15) - a hand-off notice is stale minutes later.
        # "--": an account name that starts with "-" must never read as an option.
        argv = [binary, "-a", NOTIFY_APP, "-u", urgency, "--transient", "--", summary]
        if body:
            argv.append(body)
        _NOTIFY_PROCS[:] = [p for p in _NOTIFY_PROCS if p.poll() is None]
        _NOTIFY_PROCS.append(subprocess.Popen(
            argv, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL, start_new_session=True))
        return True
    except Exception:
        return False


# ---------------------------------------------------------------------- config


def load_conf():
    conf = dict(DEFAULT_CONF)
    conf.update(read_json(CONF_FILE, {}) or {})
    if os.environ.get("CC_THRESHOLD"):
        conf["threshold"] = os.environ["CC_THRESHOLD"]
    if os.environ.get("CC_PRIMARY"):
        conf["primary"] = os.environ["CC_PRIMARY"]
    try:
        conf["threshold"] = float(conf["threshold"])
    except (TypeError, ValueError):
        conf["threshold"] = float(DEFAULT_CONF["threshold"])
    conf["primary"] = str(conf.get("primary") or DEFAULT_CONF["primary"])
    conf["paused"] = parse_pauses(conf.get("paused"))
    return conf


# ------------------------------------------------------------ parked accounts
# cc.json:
#     "paused": {"bob":   {"until": 1788800000, "since": 1788600000,
#                          "reason": "lent to a colleague"}}
# `until` may be null for an indefinite park. An entry whose `until` has passed
# is expired: ignored everywhere, and pruned the next time cc.json is written -
# which only --pause / --resume ever do, never a hook path.
PAUSE_WINDOW = "paused"          # the synthetic "window" a park hands off on
PAUSE_LABEL = "parked"
PAUSE_DEFAULT_DAYS = 3


def parse_pauses(raw, now=None):
    """cc.json's "paused" -> {account key: entry}, expired entries dropped.

    Keys are matched the way --use matches (id / name / email / local part), so
    they are lowercased here. Anything unparseable counts as NOT parked: a
    damaged cc.json must never silently take an account out of service.
    """
    out = {}
    if not isinstance(raw, dict):
        return out
    now = time.time() if now is None else now
    for key, value in raw.items():
        if not isinstance(key, str) or not key.strip():
            continue
        if value is None or value is False:
            continue
        entry = value if isinstance(value, dict) else {}
        until = entry.get("until")
        if isinstance(until, bool) or not isinstance(until, (int, float)):
            until = None  # missing, null or junk: an indefinite park
        if until is not None and until <= now:
            continue  # expired
        since = entry.get("since")
        if isinstance(since, bool) or not isinstance(since, (int, float)):
            since = None
        out[key.strip().lower()] = {"until": until, "since": since,
                                    "reason": str(entry.get("reason") or "")}
    return out


def pause_left(entry, now=None):
    """Seconds left on a park, or None when it never expires."""
    until = (entry or {}).get("until")
    if not isinstance(until, (int, float)):
        return None
    return max(0, int(until - (time.time() if now is None else now)))


def apply_pauses(accounts, conf):
    """Tell every account whether it is parked. -> the parked ones.

    The mirror of apply_model(): decisions are made against acct.paused, so an
    account list that never came through here behaves exactly as it did before.
    """
    pauses = (conf or {}).get("paused") or {}
    parked = []
    for acct in accounts:
        entry = None
        for key in sorted(acct.keys()):  # sorted: stable if two keys both match
            if key in pauses:
                entry = pauses[key]
                break
        acct.paused = entry
        if entry:
            parked.append(acct)
    return parked


def pause_tag(acct):
    """"parked 2d 4h" / "parked" - the --status STATUS cell."""
    left = pause_left(acct.paused)
    return PAUSE_LABEL if left is None else "%s %s" % (PAUSE_LABEL, fmt_span(left))


def pause_phrase(acct):
    """"Bob is parked for 2d 4h" - the launch banner note."""
    left = pause_left(acct.paused)
    return "%s is parked %s" % (acct.name,
                                "indefinitely" if left is None else "for " + fmt_span(left))


# -------------------------------------------------------------------- accounts


class Account(object):
    def __init__(self, aid, name, directory, email):
        self.id = aid
        self.name = name
        self.dir = directory
        self.email = email or ""
        self.five_hour = None
        self.seven_day = None
        self.resets_at = None
        # Every limit window /usage reported, keyed as parse_usage() keys them:
        # {"five_hour"|"seven_day"|"weekly_<model>"|<kind>:
        #  {"utilization", "resets_at", "label"}}
        self.windows = {}
        # The model this session runs; a model-scoped cap only counts for its own.
        self.model = None
        self.fetched_at = 0
        self.status = "unknown"
        # The cc.json "paused" entry parking this account, or None. Set by
        # apply_pauses(); None - the default - is the old, unparked behaviour.
        self.paused = None
        # Token-free facts about .credentials.json (creds_facts), set by
        # discover(); None means "not inspected" and never makes an account dead.
        self.creds = None
        # The credentials mtime the cached /usage status was measured against.
        self.creds_checked = None

    @property
    def is_default(self):
        return self.dir == CLAUDE_HOME

    def worst(self):
        """(key, label, utilization) of the fullest known window, else (None,)*3.

        A spent weekly cap stops an account just as dead as a spent 5-hour one,
        so every decision clx makes is made against this - never against
        five_hour alone. Ties break on the key so the answer is stable.
        """
        known_windows = [
            (key, win) for key, win in (self.windows or {}).items()
            if isinstance(win, dict) and isinstance(win.get("utilization"), (int, float))
            and applies_to(key, win, self.model)
        ]
        if not known_windows:
            return (None, None, None)
        key, win = min(known_windows, key=lambda kv: (-kv[1]["utilization"], kv[0]))
        return (key, win.get("label") or window_header(key), win["utilization"])

    def applied_windows(self):
        """The window keys this account's decisions were actually made on."""
        return sorted(key for key, win in (self.windows or {}).items()
                      if applies_to(key, win, self.model))

    def keys(self):
        """Everything --use / primary may be matched against, lowercased."""
        out = {self.id.lower(), self.name.lower()}
        if self.email:
            out.add(self.email.lower())
            out.add(self.email.split("@", 1)[0].lower())
        return out


def config_json_for(directory):
    # The default dir's config file lives beside it, not inside it.
    return os.path.join(HOME, ".claude.json") if directory == CLAUDE_HOME else os.path.join(directory, ".claude.json")


def email_of(directory):
    j = read_json(config_json_for(directory), {})
    return ((j or {}).get("oauthAccount") or {}).get("emailAddress") or ""


def titlecase(s):
    return s[:1].upper() + s[1:] if s else s


def discover():
    """Every config dir that actually holds credentials. Emails are read live."""
    found = []
    if os.path.isfile(os.path.join(CLAUDE_HOME, ".credentials.json")):
        email = email_of(CLAUDE_HOME)
        # Never assume who the default dir belongs to: /login rewrites it.
        name = titlecase(email.split("@", 1)[0]) if email else "Default"
        found.append(Account("default", name, CLAUDE_HOME, email))
    for entry in sorted(os.listdir(HOME)):
        if not entry.startswith(".claude-"):
            continue
        path = os.path.join(HOME, entry)
        # Skips ~/.claude-prelinux-restore.tgz (a file) and empty scratch dirs.
        if not os.path.isdir(path) or not os.path.isfile(os.path.join(path, ".credentials.json")):
            continue
        aid = entry[len(".claude-"):]
        found.append(Account(aid, titlecase(aid), path, email_of(path)))
    # Every decision path starts here, so every one of them sees whether a login
    # is dead - no caller has to remember a separate apply step.
    reload_creds(found)
    return found


# ------------------------------------------------------------------ dead logins
# 2026-10-02: One account's OAuth grant hit its hard refreshTokenExpiresAt (30
# days after its cm-login - rotation does NOT extend it). The next request could
# not refresh, Claude Code blanked both tokens, and every session on it showed
# "Login expired · Please run /login". The usage CACHE still said "5h 1%", so clx
# kept launching on it and the watcher handed a spent session TO it as a stale
# last resort. A dead login is now never a launch choice or a hand-off target,
# and a session sitting on one is moved off at once (trigger window "auth").
# Polling keeps running, so the account comes back the moment it is re-logged.
AUTH_WINDOW = "auth"
AUTH_FAIL_STATUSES = ("http-401", "http-403")
RENEW_WARN = 3 * 86400  # --status warns this long before a refresh token's hard expiry


def creds_facts(directory):
    """Token-free facts about <directory>/.credentials.json, or None.

    Presence flags and timestamps only: a token value never leaves this
    function. None ("could not read it") is NOT evidence of a dead login - a
    damaged or half-written file must never take an account out of service.
    """
    path = os.path.join(directory, ".credentials.json")
    try:
        mtime = os.stat(path).st_mtime
    except OSError:
        return None
    doc = read_json(path, {})
    oauth = doc.get("claudeAiOauth") if isinstance(doc, dict) else None
    if not isinstance(oauth, dict):
        return None

    def stamp(value):
        return value if isinstance(value, (int, float)) and not isinstance(value, bool) else None

    return {
        "access": bool(oauth.get("accessToken")),
        "refresh": bool(oauth.get("refreshToken")),
        "expires_at": stamp(oauth.get("expiresAt")),                   # ms
        "refresh_expires_at": stamp(oauth.get("refreshTokenExpiresAt")),  # ms
        "mtime": mtime,
    }


def reload_creds(accounts):
    """Re-read every account's credential facts (after a heal may have changed one)."""
    for acct in accounts:
        acct.creds = creds_facts(acct.dir)
    return accounts


def auth_problem(acct, now=None):
    """Why this account cannot authenticate - or None when it can, or we cannot tell.

    An expired ACCESS token alone is fine: Claude Code refreshes it on the next
    request. Dead means nothing can be refreshed either:
      * "logged out": both tokens blank - what Claude Code leaves behind after a
        refresh it could not do;
      * "login expired": the access token has expired and the refresh token is
        missing or past refreshTokenExpiresAt;
      * "token rejected (http-401|403)": /usage refused an access token that has
        not expired, measured against THIS file (credsMtime) - so a re-login
        clears the verdict at once rather than one poll later.
    """
    facts = getattr(acct, "creds", None)
    if not facts:
        return None
    now_ms = (time.time() if now is None else now) * 1000.0
    exp, rexp = facts.get("expires_at"), facts.get("refresh_expires_at")
    access_ok = facts.get("access") and (exp is None or exp > now_ms)
    refresh_ok = facts.get("refresh") and (rexp is None or rexp > now_ms)
    if not facts.get("access") and not facts.get("refresh"):
        return "logged out"
    if not access_ok and not refresh_ok:
        return "login expired"
    if (access_ok and acct.status in AUTH_FAIL_STATUSES
            and getattr(acct, "creds_checked", None) == facts.get("mtime")):
        return "token rejected (%s)" % acct.status
    return None


def login_command(acct):
    """"cm-login carol carol@example.com" - the one fix for a dead login."""
    return "cm-login %s%s" % (acct.id, " " + acct.email if acct.email else "")


def login_hint(acct):
    """"Carol logged out - run: cm-login carol carol@example.com"."""
    return "%s %s - run: %s" % (acct.name, auth_problem(acct) or "needs a login",
                                login_command(acct))


def renewal_due(acct, now=None):
    """Seconds until a LIVE login's refresh token hard-expires, when that is soon."""
    facts = getattr(acct, "creds", None) or {}
    rexp = facts.get("refresh_expires_at")
    if not rexp or auth_problem(acct, now):
        return None
    left = rexp / 1000.0 - (time.time() if now is None else now)
    return left if left < RENEW_WARN else None


def dedupe(accounts, primary_key):
    """One dir per account.

    Two dirs holding the same login both refresh it, and each refresh rotates the
    refresh token, so the loser's credentials go stale and its next launch fails.
    Prefer the named ~/.claude-<name> dir; for the primary prefer the default dir,
    so a bare `claude` and `clx` agree on which login is primary.
    """
    groups = {}
    order = []
    for acct in accounts:
        key = acct.email.lower() if acct.email else "dir:" + acct.dir
        if key not in groups:
            groups[key] = []
            order.append(key)
        groups[key].append(acct)

    kept, notes = [], []
    for key in order:
        group = groups[key]
        if len(group) == 1:
            kept.append(group[0])
            continue
        is_primary = any(primary_key in a.keys() for a in group)
        named = [a for a in group if not a.is_default]
        default = [a for a in group if a.is_default]
        if is_primary and default:
            winner = default[0]
        else:
            winner = (named or default)[0]
        losers = [a for a in group if a is not winner]
        kept.append(winner)
        notes.append(
            "clx: %s is logged in to %d dirs - using %s, ignoring %s (two dirs refreshing one "
            "account fight over the rotated refresh token)"
            % (group[0].email or key, len(group), winner.dir, ", ".join(a.dir for a in losers))
        )
    return kept, notes


def find_primary(accounts, primary_key):
    for acct in accounts:
        if primary_key in acct.keys():
            return acct
    return None


def match_account(accounts, needle):
    n = (needle or "").strip().lower()
    for acct in accounts:
        if n in acct.keys():
            return acct
    return None


# ----------------------------------------------------------------------- usage


def access_token(directory):
    creds = read_json(os.path.join(directory, ".credentials.json"), {})
    return ((creds or {}).get("claudeAiOauth") or {}).get("accessToken") or ""


def iso_to_epoch(value):
    if not value:
        return None
    if isinstance(value, (int, float)):
        return int(value)
    try:
        return int(datetime.fromisoformat(str(value)).astimezone(timezone.utc).timestamp())
    except Exception:
        return None


WINDOW_LABELS = {"five_hour": "5h", "seven_day": "7d"}

# limits[] kinds that are another name for a window we already parse. Measured
# 2026-09-03 on live accounts: `session` repeats five_hour and `weekly_all`
# repeats seven_day, so without this they became duplicate columns.
LIMIT_ALIASES = {"session": "five_hour", "weekly_all": "seven_day"}


def model_slug(name):
    return re.sub(r"[^a-z0-9]+", "-", (name or "model").lower()).strip("-") or "model"


def window_header(key):
    """The short label / --status column title for a window key."""
    if key in WINDOW_LABELS:
        return WINDOW_LABELS[key]
    if key.startswith("weekly_"):
        return "WK-" + key[len("weekly_"):].upper().replace("_", "-")
    return (key or "?").upper().replace("_", "-")


def parse_usage(data):
    """/api/oauth/usage -> {key: {"utilization", "resets_at", "label"}}.

    Field names follow claude-meter's buildUsage() (~/claude-meter/main.js), the
    reference implementation: five_hour and seven_day carry `utilization`, while
    a model-scoped weekly cap arrives in the `limits` array as kind
    "weekly_scoped" carrying `percent` and scope.model.display_name (Fable
    today). The old fixed seven_day_sonnet field is null on current plans and is
    kept only as a fallback. Any other limits[] entry with a number becomes a
    window under its own kind, so a new cap starts counting the day it appears.
    """
    windows = {}

    def add(key, label, utilization, resets_at, model=None):
        if not key or key in windows or not isinstance(utilization, (int, float)):
            return
        windows[key] = {
            "utilization": utilization,
            "resets_at": iso_to_epoch(resets_at),
            "label": label,
        }
        # A model-scoped cap records WHICH model, so a session on another one can
        # ignore it without having to guess from the key.
        if model:
            windows[key]["model"] = model
            windows[key]["model_family"] = model_family(model)

    five = data.get("five_hour") or {}
    seven = data.get("seven_day") or {}
    add("five_hour", "5h", five.get("utilization"), five.get("resets_at"))
    add("seven_day", "7d", seven.get("utilization"), seven.get("resets_at"))

    for entry in (data.get("limits") or []):
        if not isinstance(entry, dict):
            continue
        kind = entry.get("kind") or ""
        value = entry.get("utilization")
        if not isinstance(value, (int, float)):
            value = entry.get("percent")
        if kind == "weekly_scoped":
            model = ((entry.get("scope") or {}).get("model") or {}).get("display_name") or "model"
            add("weekly_" + model_slug(model), "Weekly (%s)" % model, value,
                entry.get("resets_at"), model=model)
        else:
            key = LIMIT_ALIASES.get(kind, kind)
            add(key, window_header(key), value, entry.get("resets_at"))

    legacy = data.get("seven_day_sonnet") or {}
    add("weekly_sonnet", "Weekly (Sonnet)", legacy.get("utilization"), legacy.get("resets_at"),
        model="Sonnet")
    return windows


def derive_windows(entry):
    """Windows for a cache entry written before clx knew about them."""
    windows = {}
    if isinstance(entry.get("five_hour"), (int, float)):
        windows["five_hour"] = {"utilization": entry["five_hour"],
                                "resets_at": entry.get("resets_at"), "label": "5h"}
    if isinstance(entry.get("seven_day"), (int, float)):
        windows["seven_day"] = {"utilization": entry["seven_day"], "resets_at": None, "label": "7d"}
    return windows


def window_keys(accounts):
    """Every window any account has: 5h and 7d first, the rest alphabetical."""
    keys = set()
    for acct in accounts:
        keys.update((acct.windows or {}).keys())
    ordered = [k for k in ("five_hour", "seven_day") if k in keys]
    return (ordered + sorted(k for k in keys if k not in ("five_hour", "seven_day"))) \
        or ["five_hour", "seven_day"]


def lock_slot(text):
    """A stable byte offset for an account id. A collision only costs a tick."""
    value = 0
    for ch in text or "":
        value = (value * 131 + ord(ch)) & 0xFFFFFFFF
    return value % LOCK_SLOTS


class FetchClaim(object):
    """Non-blocking, cross-process claim on ONE account's /usage call.

    Whoever takes the claim fetches; everybody else re-reads the cache and uses
    the answer the winner writes. That is what keeps the call rate a property of
    the account list rather than of how many terminals happen to be open.

    A byte range in one file rather than a file per account: no clutter, and the
    kernel drops the lock when the holder dies, so a crash never wedges it. If
    the lock file cannot be opened at all the claim reports HELD - a broken lock
    must never stop clx from refreshing.
    """

    def __init__(self, account_id):
        self.offset = lock_slot(account_id)
        self.fd = None
        self.held = False

    def __enter__(self):
        try:
            self.fd = os.open(USAGE_LOCK, os.O_RDWR | os.O_CREAT, 0o600)
        except OSError:
            self.held = True  # no lock file: behave exactly as clx did before
            return self
        try:
            fcntl.lockf(self.fd, fcntl.LOCK_EX | fcntl.LOCK_NB, 1, self.offset)
            self.held = True
        except OSError:
            self._close()
        return self

    def __exit__(self, *exc_info):
        self._close()
        return False

    def _close(self):
        if self.fd is not None:
            try:
                fcntl.lockf(self.fd, fcntl.LOCK_UN, 1, self.offset)
            except OSError:
                pass
            try:
                os.close(self.fd)
            except OSError:
                pass
        self.fd = None
        self.held = False


def entry_due(entry, now, window):
    """Is this cache entry old enough to poll again?

    checkedAt gates the polling; fetchedAt is how old the numbers are. A 429
    bumps checkedAt only, so a rate-limited account is not re-hammered - and a
    429'd account always waits the FULL TTL, whatever window the caller asked
    for: the rate limiter has just said no, and a shorter window argues with it.
    """
    last_try = max(entry.get("checkedAt") or 0, entry.get("fetchedAt") or 0)
    if entry.get("status") == "429":
        window = max(window, TTL)
    return now - last_try >= window


class _NoRedirect(urllib.request.HTTPRedirectHandler):
    """urllib copies every header, Authorization included, to a redirect target:
    a 3xx is an error here, never a second request carrying the token."""

    def redirect_request(self, *args, **kwargs):
        return None


_OPENER = urllib.request.build_opener(_NoRedirect)


def fetch_usage(directory):
    """(entry, status). Never raises: a failure is 'unknown', not an error."""
    token = access_token(directory)
    if not token:
        return None, "no-token"
    req = urllib.request.Request(
        USAGE_URL,
        headers={
            "Authorization": "Bearer " + token,
            "anthropic-beta": "oauth-2025-04-20",
            "User-Agent": USER_AGENT,
            "Accept": "application/json",
        },
    )
    try:
        with _OPENER.open(req, timeout=HTTP_TIMEOUT) as resp:
            data = json.load(resp)
    except urllib.error.HTTPError as exc:
        # 429 is routine here (the limit is per token) - it means "unknown", so the
        # caller keeps whatever it already had.
        return None, "429" if exc.code == 429 else "http-%d" % exc.code
    except Exception as exc:
        return None, "err-" + type(exc).__name__
    windows = parse_usage(data)
    five = windows.get("five_hour") or {}
    seven = windows.get("seven_day") or {}
    return (
        {
            # The two flat fields stay for compatibility with everything that
            # already reads this cache; `windows` is the whole truth.
            "five_hour": five.get("utilization"),
            "seven_day": seven.get("utilization"),
            "resets_at": five.get("resets_at"),
            "windows": windows,
            "fetchedAt": int(time.time()),
            "status": "ok",
        },
        "ok",
    )


def refresh(accounts, force=False, only=None, ttl=None):
    """Fill each account from the cache, refetching only what is stale.

    Returns the number of HTTP calls made. `ttl` overrides how old an entry may
    be before it is refetched - the watcher passes NEAR_TTL for an account that
    is close to its threshold; everything else keeps the 180 s default.
    """
    cache = read_json(CACHE_FILE, {}) or {}
    now = int(time.time())
    calls = 0
    updated = set()
    window = TTL if ttl is None else ttl
    for acct in accounts:
        entry = cache.get(acct.id) or {}
        wanted = only is None or acct.id == only
        if wanted and (force or entry_due(entry, now, window)):
            with FetchClaim(acct.id) as claim:
                # Somebody else is calling /usage for this account this instant:
                # take their answer rather than make a second identical call.
                # --sync (force) is the one deliberate, user-driven exception.
                fresh_entry = (read_json(CACHE_FILE, {}) or {}).get(acct.id)
                if fresh_entry:
                    entry = fresh_entry
                if (claim.held or force) and (force or entry_due(entry, now, window)):
                    # Which credentials file this answer is about: a 401 only
                    # condemns the file it was measured against (auth_problem).
                    # Stat BEFORE the token is read, so a file replaced mid-call
                    # can only make the verdict not apply - never wrongly apply.
                    try:
                        creds_mtime = os.stat(os.path.join(acct.dir, ".credentials.json")).st_mtime
                    except OSError:
                        creds_mtime = None
                    fresh, status = fetch_usage(acct.dir)
                    calls += 1
                    if fresh:
                        entry = fresh
                    else:
                        entry = dict(entry)
                        entry["status"] = status
                    entry["checkedAt"] = int(time.time())
                    entry["credsMtime"] = creds_mtime
                    entry["email"] = acct.email
                    entry["dir"] = acct.dir
                    cache[acct.id] = entry
                    updated.add(acct.id)
        acct.five_hour = entry.get("five_hour")
        acct.seven_day = entry.get("seven_day")
        acct.resets_at = entry.get("resets_at")
        # Old cache entries predate `windows`; derive them from the two flat fields.
        acct.windows = entry.get("windows") or derive_windows(entry)
        acct.fetched_at = entry.get("fetchedAt") or 0
        acct.status = entry.get("status") or "unknown"
        acct.creds_checked = entry.get("credsMtime")
        if acct.id in updated:
            # For readers that must never open a credentials file (a desktop
            # panel, say): the verdict, as a string or null.
            entry["auth"] = auth_problem(acct)
    if calls:
        # Re-read before writing: a background --refresh-one may have landed.
        merged = read_json(CACHE_FILE, {}) or {}
        merged.update({k: v for k, v in cache.items() if k in updated})
        meta = merged.get(META_KEY) or {}
        meta["usageCalls"] = (meta.get("usageCalls") or 0) + calls
        meta["lastCallAt"] = now
        merged[META_KEY] = meta
        write_json_atomic(CACHE_FILE, merged)
    return calls


def spawn_refresh(account_id, *more):
    """Detached refresh, so no caller ever blocks on the network.

    Takes several account ids on purpose: the hook has a 100 ms budget and a
    stuck session asks about every candidate at once. One child that refreshes
    all of them is one fork; one child each was three, and measured 15-20 ms of
    the budget on a loaded machine.
    """
    ids = [str(a) for a in (account_id,) + more if a]
    if not ids:
        return
    try:
        subprocess.Popen(
            [sys.executable, "-I", os.path.abspath(__file__), "--refresh-one"] + ids,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
        )
    except Exception:
        pass


# ------------------------------------------------------------------- selection


# --- which model is this session actually running? ---------------------------
# The weekly cap /usage reports is MODEL-SCOPED ("Weekly (Fable)"). Counting it
# while the session runs Opus made clx conclude "no account with every window
# under 90% - staying put" with two accounts wide open (2026-09-04). A window
# only constrains a session that is actually using the model it is scoped to.
MODEL_TAIL = int(os.environ.get("CC_MODEL_TAIL") or 65536)
# What to suggest when a model's own cap is what is blocking everything.
MODEL_ALTERNATIVE = {"fable": "opus", "opus": "sonnet", "sonnet": "opus", "haiku": "opus"}
_MODEL_MEMO = {}


def model_family(name):
    """"claude-opus-5[1m]" / "fable-5-1" / "opus[1m]" -> "opus" / "fable".

    Everything before a leading `claude-` is dropped (so a bedrock-style id works
    too), then the first alphabetic run is the family. "<synthetic>" and anything
    else that does not start with a letter yields None.
    """
    text = (name or "").strip().lower()
    if "claude-" in text:
        text = text.split("claude-", 1)[1]
    match = re.match(r"[a-z]+", text)
    return match.group(0) if match else None


def transcript_model(path):
    """The newest assistant model named in a transcript, or None.

    Only the last MODEL_TAIL bytes are read - one seek and one read - because
    this runs on every hook event. A partial first line is dropped, and
    "<synthetic>" entries are skipped: they are Claude Code's own bookkeeping
    messages, not a model that answered.
    """
    if not path:
        return None
    try:
        size = os.path.getsize(path)
    except OSError:
        return None
    # Keyed on the size too: a transcript that grew has a newer answer in it, and
    # the watcher lives for hours.
    key = (path, size)
    if key in _MODEL_MEMO:
        return _MODEL_MEMO[key]
    name = None
    try:
        with open(path, "rb") as fh:
            if size > MODEL_TAIL:
                fh.seek(size - MODEL_TAIL)
                fh.readline()  # the first line is almost certainly cut in half
            blob = fh.read()
        for line in reversed(blob.split(b"\n")):
            if b'"assistant"' not in line or b'"model"' not in line:
                continue
            try:
                entry = json.loads(line.decode("utf-8", "replace"))
            except ValueError:
                continue
            if not isinstance(entry, dict) or entry.get("type") != "assistant":
                continue
            candidate = ((entry.get("message") or {}).get("model") or "").strip()
            if candidate and candidate != "<synthetic>":
                name = candidate
                break
    except (OSError, ValueError):
        name = None
    # The watcher lives for hours and now asks for the model every 30 s, so the
    # memo must not grow with the transcript. Consecutive lookups share a key;
    # dropping the rest costs nothing that matters.
    if len(_MODEL_MEMO) > 256:
        _MODEL_MEMO.clear()
    _MODEL_MEMO[key] = name
    return name


def settings_model():
    """The `model` pin from the settings file this session actually reads."""
    for path in (os.path.join(os.environ.get("CLAUDE_CONFIG_DIR") or CLAUDE_HOME, "settings.json"),
                 os.path.join(CLAUDE_HOME, "settings.json")):
        value = (read_json(path, {}) or {}).get("model")
        if isinstance(value, str) and value.strip():
            return value
    return ""


def session_model(payload=None):
    """The live model family, or None when nothing says which model is running."""
    return model_family(
        transcript_model((payload or {}).get("transcript_path"))
        or os.environ.get("ANTHROPIC_MODEL")
        or settings_model()
    )


def window_model_family(key, win):
    """The model family a window is scoped to, or None when it binds every model."""
    family = (win or {}).get("model_family")
    if family:
        return str(family).lower()
    if key.startswith("weekly_"):
        return model_family(key[len("weekly_"):])
    return None


def applies_to(key, win, model):
    """Does this window constrain a session running `model`?

    5h and 7d always do. A model-scoped cap only does when the session is on that
    model. An unknown model counts everything, which is the old behaviour.
    """
    if not model:
        return True
    family = window_model_family(key, win)
    return family is None or family == model


def apply_model(accounts, model):
    """Tell every account which model the decision is being made for."""
    for acct in accounts:
        acct.model = model
    return model


def model_block(accounts, exclude_ids, threshold, model):
    """Model-scoped caps that are the ONLY thing standing in the way.

    -> {"label", "model", "suggest", "accounts": [(name, value), ...]} or None.

    Switching accounts cannot fix a cap that follows the model, so when every
    candidate is blocked ONLY by one of those, the answer is to change the model,
    not the account. If any candidate is also over a window that binds every
    model, a model switch would not free it and this returns None.
    """
    if not model:
        return None
    label = None
    freed = []
    for acct in accounts:
        if not known(acct) or is_stale(acct):
            continue  # a frozen number cannot prove anything about this account
        scoped = over = None
        for key, win in (acct.windows or {}).items():
            value = (win or {}).get("utilization")
            if not isinstance(value, (int, float)):
                continue
            if not applies_to(key, win, model):
                continue
            if window_model_family(key, win):
                if value >= threshold and scoped is None:
                    scoped = (win.get("label") or window_header(key), value)
            elif value >= threshold:
                over = True
        if acct.id in exclude_ids or acct.paused or auth_problem(acct):
            continue  # a parked or logged-out account cannot take this session, on any model
        if over or scoped is None:
            continue  # blocked for every model, or not blocked at all
        freed.append(acct)
        label = label or scoped[0]
    if not freed:
        return None
    named = []
    for acct in accounts:
        for key, win in (acct.windows or {}).items():
            if (window_model_family(key, win) == model
                    and isinstance((win or {}).get("utilization"), (int, float))
                    and win["utilization"] >= threshold):
                named.append((acct.name, win["utilization"]))
                break
    return {"label": label, "model": model, "suggest": MODEL_ALTERNATIVE.get(model, "opus"),
            "accounts": named}


def nowhere_reason(current, accounts, now=None):
    """Why there is nowhere to go, candidate by candidate, ages included.

    "every other account is over 90% — Alice 5h 90% (3h old), Carol 7d 94%"
    is actionable; "all accounts are full" on its own is a shrug. The age is the
    part that matters: it says whether the answer was measured or remembered.
    """
    parts = []
    for acct in candidate_pool(accounts or [], {current.id}):
        parts.append("%s %s%s" % (acct.name, window_tag(acct), stale_note(acct, now)))
    for acct in (accounts or []):
        if acct.id == current.id:
            continue
        if auth_problem(acct):
            parts.append("%s %s" % (acct.name, auth_problem(acct)))
        elif acct.paused:
            parts.append("%s parked" % acct.name)
    return ", ".join(parts)


def stuck_notice(current, spent, nxt, block, accounts=None):
    """(key, summary, body) when this session is spent with nowhere to go, else None.

    The key is what "once per distinct state" is keyed on: the account and the
    window that filled - never the percentage, which ticks up every minute and
    would notify on every watcher tick. The BODY carries the reason, so the one
    popup the user gets says which accounts were checked and how old each answer
    was, instead of leaving them to guess.
    """
    if not spent or nxt is not None:
        return None
    body = nowhere_reason(current, accounts) if accounts else ""
    if block:
        # NOT "all accounts are full": only this MODEL's cap is, and no account
        # change can fix that. Saying the wrong thing is worse than saying nothing.
        return ("model:%s" % block["model"],
                "%s is spent on every account — switch the model (/model %s)"
                % (block["label"], block["suggest"]),
                body)
    if spent[0] == AUTH_WINDOW:
        return ("auth:%s" % current.id,
                "%s — and no other account can take this session" % login_hint(current),
                body)
    if spent[0] == PAUSE_WINDOW:
        return ("parked:%s" % current.id,
                "All accounts are full or parked — %s is parked" % current.name,
                body)
    return ("%s:%s" % (current.id, spent[0]),
            "All accounts are full — %s is at %s%%" % (current.name, fmt_pct(spent[2])),
            body)


def model_block_message(block):
    return (
        "[clx] %s is spent on every account (%s). Switching accounts will not help - "
        "switch the model instead (/model %s).\n"
        % (block["label"],
           ", ".join("%s %s%%" % (name, fmt_pct(value)) for name, value in block["accounts"]),
           block["suggest"])
    )


def known(acct):
    """Has /usage answered with at least one window that binds this session?

    NOT "is there a 5-hour number". The feed stopped carrying a 5h window
    (2026-11-09: five_hour null on every account, 7d and Weekly (Fable) still
    there), which made every account read as unknown - so nothing was ever
    spent, no hand-off fired, and targets were picked in list order.
    """
    return acct.worst()[0] is not None


def five_rank(acct):
    """The 5h tie-break as a number: no 5h window means none of it is used.

    Comparing None with a float raises, and a tie on the worst window between an
    account that reports 5h and one that does not is an ordinary state now.
    """
    return acct.five_hour if isinstance(acct.five_hour, (int, float)) else 0.0


def launch_tag(acct, bare=False):
    """What the launch banner says about an account's usage.

    The 5h figure when there is one (the text every banner has always carried),
    otherwise the worst window that was measured - never "5h ?" for an account
    whose 7d and model caps are known.
    """
    if isinstance(acct.five_hour, (int, float)):
        return fmt_usage(acct.five_hour) if bare else "5h %s" % fmt_usage(acct.five_hour)
    if acct.worst()[0] is None:
        return "?" if bare else "5h ?"
    return window_tag(acct)


def over_threshold(acct, threshold):
    """(key, label, value) of a window that is spent, or None.

    "Spent" is ANY window at or over the threshold - the 5-hour one, the 7-day
    one, or a model-scoped weekly cap. worst() is the maximum, so testing it
    tests every window at once.
    """
    key, label, value = acct.worst()
    if key is None or value < threshold:
        return None
    return (key, label, value)


def under_threshold(acct, threshold):
    """True only when EVERY known window of this account is under the threshold."""
    key, _, value = acct.worst()
    return key is not None and value < threshold


def near_threshold(acct, threshold, margin=None):
    """Is the fullest APPLICABLE window close enough to spending to matter?

    What the watcher tests before it fetches: at 70 % a three-minute-old number
    is fine, at 90 % it is a decision made about the past.
    """
    key, _, value = acct.worst()
    if key is None:
        return False
    return value >= threshold - (NEAR_MARGIN if margin is None else margin)


def stale_ttl():
    """The age at which a cached number stops counting as a measurement.

    Read at call time, not frozen at import: TTL itself is an env override and
    the suites pin it on the module.
    """
    raw = os.environ.get("CC_STALE_TTL")
    if raw:
        try:
            return max(NEAR_TTL, int(raw))
        except ValueError:
            pass
    return max(NEAR_TTL, int(TTL * STALE_FACTOR))


def entry_age(acct, now=None):
    """Seconds since this account's numbers were fetched, or None if never."""
    if not acct.fetched_at:
        return None
    return max(0, int((time.time() if now is None else now) - acct.fetched_at))


def is_stale(acct, now=None):
    """Are this account's numbers too old to conclude anything from?

    Staleness is a STATE, not a value. Nobody polls an account no session is
    sitting on, so the number frozen there describes the moment the last session
    LEFT it - which by definition was at or over the threshold.
    """
    age = entry_age(acct, now)
    return age is None or age >= stale_ttl()


def stale_note(acct, now=None):
    """" (3h old)" for a frozen entry, "" for a current one."""
    age = entry_age(acct, now)
    if age is None:
        return " (never measured)"
    return " (%s old)" % fmt_age(age) if age >= stale_ttl() else ""


def window_tag(acct, key=None):
    """"7d 91%" for a named window, else "worst 5h 12%" for the account's worst."""
    win = (acct.windows or {}).get(key) if key else None
    if isinstance(win, dict) and isinstance(win.get("utilization"), (int, float)):
        return "%s %s%%" % (win.get("label") or window_header(key), fmt_pct(win["utilization"]))
    wkey, label, value = acct.worst()
    if wkey is None:
        return "usage unknown"
    return "worst %s %s%%" % (label, fmt_pct(value))


def candidate_pool(accounts, exclude_ids):
    """Every account a session could be handed to right now.

    Never a parked account, and never a DEAD login (auth_problem): its cached
    numbers may look like head-room, but every request on it fails with "Login
    expired". This is the one filter best_candidate(), stale_candidates() and
    the launch fallback all share.
    """
    return [a for a in accounts
            if a.id not in exclude_ids and not a.paused and not auth_problem(a)]


def stale_candidates(accounts, exclude_ids, max_age=None, now=None):
    """Candidates whose numbers are older than `max_age` (default: stale_ttl()).

    These are the accounts a "nowhere to go" answer would be built on, and the
    ones nobody refreshes - the two facts that made the bug.
    """
    limit = stale_ttl() if max_age is None else max_age
    out = []
    for acct in candidate_pool(accounts, exclude_ids):
        age = entry_age(acct, now)
        if age is None or age >= limit:
            out.append(acct)
    return out


def best_candidate(accounts, exclude_ids, threshold, allow_stale=False, now=None):
    """The account with the most head-room, or None.

    EVERY window must be under the threshold: an account whose 5h is 0% but
    whose weekly cap sits at 95% has no head-room at all and handing a session
    to it would fail on the next request. Ranked by the worst window, then 5h,
    then name, so the choice is stable. Unknowns are the last resort.

    A PARKED account is never a candidate, whatever its head-room: it is lent
    out, and clx must not put a session on it. Nor is a DEAD login
    (auth_problem): its frozen numbers look like head-room and it cannot answer
    one request - both filters live in candidate_pool().

    A STALE entry proves nothing in either direction. It is not head-room, and -
    this is the whole finding - it is not "over" either: it is the number that
    account had when the last session LEFT it, which was by definition at or over
    the threshold. So None here does not mean "everywhere is full", it means
    "nothing is KNOWN to be free", and every caller must re-measure before acting
    on it (watch_refresh_candidates / request_candidate_refresh).

    `allow_stale` is what a caller passes once measuring has been tried and has
    failed - at launch, right after refresh(), or on the tick after a 429. Then
    an account that was UNDER the threshold when it was last seen is offered as a
    last resort: it still beats sitting on an account that is spent right now. An
    account last seen at or over the threshold is never offered, whatever its
    age: nothing about it says it has room.
    """
    pool = candidate_pool(accounts, exclude_ids)
    under = [a for a in pool
             if known(a) and not is_stale(a, now) and under_threshold(a, threshold)]
    if under:
        return min(under, key=lambda a: (a.worst()[2], five_rank(a), a.name))
    unknown = [a for a in pool if not known(a)]
    if unknown:
        return unknown[0]
    if allow_stale:
        stale_under = [a for a in pool
                       if known(a) and is_stale(a, now) and under_threshold(a, threshold)]
        if stale_under:
            return min(stale_under, key=lambda a: (a.worst()[2], five_rank(a), a.name))
    return None


def select(accounts, conf, forced=None):
    """-> (chosen, next_account, reason, notes)"""
    threshold = conf["threshold"]
    primary_key = conf["primary"].strip().lower()
    primary = find_primary(accounts, primary_key)
    notes = []

    if forced is not None:
        chosen, reason = forced, "forced"
    elif primary is None:
        # With every account spent, the emptiest live UNPARKED one; the old
        # accounts[0] fallback only when parked or dead logins are all there is.
        chosen = (best_candidate(accounts, set(), threshold, allow_stale=True)
                  or least_full(accounts, set())
                  or next((a for a in accounts if not auth_problem(a)), accounts[0]))
        if primary_key:
            notes.append("primary %s: not logged in — run: cm-login %s" % (conf["primary"], conf["primary"]))
            reason = "primary %s not logged in" % conf["primary"]
        else:
            # No primary configured: a fresh install just takes the most room.
            reason = "most room (no primary set)"
    elif auth_problem(primary):
        # A dead login is launched on only when nothing else can authenticate:
        # the session would open straight onto "Login expired". An account over
        # the threshold still beats that - it works until it is actually spent.
        alt = (best_candidate(accounts, {primary.id}, threshold, allow_stale=True)
               or least_full(accounts, {primary.id}))
        if alt is None:
            chosen = primary
            reason = "%s %s, nowhere else to go" % (primary.name, auth_problem(primary))
        else:
            chosen, reason = alt, "%s %s" % (primary.name, auth_problem(primary))
    elif primary.paused:
        # Parked: never launched, not even as the primary. Fall through to the
        # normal "best other account" logic; the banner says why.
        alt = (best_candidate(accounts, {primary.id}, threshold, allow_stale=True)
               or least_full(accounts, {primary.id}))
        if alt is None:
            chosen = primary
            reason = "%s parked, nowhere else to go" % primary.name
            notes.append("clx: every account is parked or spent - launching on %s anyway"
                         % primary.name)
        else:
            chosen, reason = alt, "%s parked" % primary.name
    else:
        spent = over_threshold(primary, threshold) if known(primary) else None
        if spent is None:
            chosen, reason = primary, "primary under threshold"
        else:
            alt = best_candidate(accounts, {primary.id}, threshold, allow_stale=True)
            if alt is None:
                chosen, reason = primary, "every account at/over threshold or unknown"
                notes.append("clx: no account with every window under %g%% - staying on %s"
                             % (threshold, primary.name))
            else:
                chosen = alt
                reason = "%s %s %s%% ≥ %g%s" % (
                    primary.name, spent[1], fmt_pct(spent[2]), threshold,
                    " (on %s)" % primary.model if primary.model else "")
                if not known(alt):
                    notes.append("clx: %s usage unknown - picked as a last resort" % alt.name)
                elif is_stale(alt):
                    notes.append("clx: %s was last measured %s ago - picked as a last resort"
                                 % (alt.name, fmt_age(entry_age(alt))))

    # Name every parked account: "why not Bob?" is the first question a launch
    # on a different account raises. A dead login is named with its fix, every
    # launch, until someone runs it.
    for acct in accounts:
        if auth_problem(acct):
            notes.append("clx: " + login_hint(acct))
        elif acct.paused and acct is not chosen:
            notes.append("clx: " + pause_phrase(acct))

    nxt = best_candidate(accounts, {chosen.id}, threshold, allow_stale=True)
    return chosen, nxt, reason, notes


def least_full(accounts, exclude_ids):
    """Launch-only last resort: the live, unparked account with the emptiest worst window.

    For when no account is under the threshold but the alternative is a dead
    login - an account at 95 % still answers requests; a logged-out one never
    does. Never used for a hand-off: moving a running session onto another
    account that is just as spent is churn, not a fix.
    """
    pool = candidate_pool(accounts, exclude_ids)
    if not pool:
        return None
    return min(pool, key=lambda a: (a.worst()[2] if a.worst()[0] is not None else 101, a.name))


# ------------------------------------------------------------------ formatting


def fmt_pct(value):
    if not isinstance(value, (int, float)):
        return "?"
    return "%g" % round(float(value))


def fmt_usage(value):
    """A percentage, or "?" when /usage never answered for this account."""
    return fmt_pct(value) + "%" if isinstance(value, (int, float)) else "?"


def fmt_age(seconds):
    if seconds is None:
        return "-"
    seconds = int(seconds)
    if seconds < 90:
        return "%ds" % seconds
    if seconds < 5400:
        return "%dm" % round(seconds / 60.0)
    return "%dh" % round(seconds / 3600.0)


RED = "\033[31m"
COLOUR_OFF = "\033[0m"


def paint(text, colour=RED):
    """Colour on a terminal, plain text down a pipe, a file or a test."""
    try:
        if os.environ.get("NO_COLOR") or not sys.stdout.isatty():
            return text
    except Exception:
        return text
    return colour + text + COLOUR_OFF


def fmt_span(seconds):
    """A duration a human reads at a glance: "2d 4h", "5h 10m", "12m", "40s".

    Rounded to the nearest minute once it is over a minute: a park set for three
    days is 259199 s by the time it is printed, and that must read "3d", not
    "2d 23h".
    """
    seconds = max(0, int(seconds or 0))
    if seconds < 60:
        return "%ds" % seconds
    days, rest = divmod(int(round(seconds / 60.0)), 1440)
    hours, minutes = divmod(rest, 60)
    if days:
        return "%dd %dh" % (days, hours) if hours else "%dd" % days
    if hours:
        return "%dh %dm" % (hours, minutes) if minutes else "%dh" % hours
    return "%dm" % minutes


def fmt_reset(epoch):
    if not epoch:
        return "-"
    left = epoch - int(time.time())
    return fmt_age(left) if left > 0 else "now"


# ------------------------------------------------------- shared profile layout


def ensure_links(directory, report):
    for name in LINK_NAMES:
        src = os.path.join(CLAUDE_HOME, name)
        dst = os.path.join(directory, name)
        if not os.path.exists(src):
            report.append("skip %s: no ~/.claude/%s" % (name, name))
            continue
        if os.path.islink(dst):
            if os.path.realpath(dst) == os.path.realpath(src):
                continue
            os.unlink(dst)
            report.append("relinked %s (pointed elsewhere)" % dst)
        elif os.path.exists(dst) and os.path.samefile(dst, src):
            continue  # already the very same file (a hard link, or a linked parent dir)
        elif os.path.exists(dst):
            aside = dst + ".pre-clx"
            n = 1
            while os.path.exists(aside):
                n += 1
                aside = "%s.pre-clx.%d" % (dst, n)
            os.rename(dst, aside)
            report.append("moved aside %s -> %s" % (dst, aside))
        os.symlink(src, dst)
        report.append("linked %s -> %s" % (dst, src))


def merge_prefs(directory, report):
    """Copy the user's preferences into <dir>/.claude.json so clx never prompts.

    Identity (oauthAccount, userID) and anything token/key/secret/account stays
    the dir's own. A project the user already trusted is trusted here too.
    """
    src = read_json(os.path.join(HOME, ".claude.json"), {}) or {}
    dst_path = config_json_for(directory)
    dst = read_json(dst_path, {}) or {}

    if os.path.exists(dst_path) and not os.path.exists(dst_path + ".pre-clx"):
        shutil.copy2(dst_path, dst_path + ".pre-clx")
        os.chmod(dst_path + ".pre-clx", 0o600)

    copied = []
    for key, value in src.items():
        if key in PREF_EXCLUDE_EXACT:
            continue
        if any(bad in key.lower() for bad in PREF_EXCLUDE_SUBSTR):
            continue
        dst[key] = copy.deepcopy(value)
        copied.append(key)

    # Trust mirrors the user's own config and is never granted: a folder not accepted
    # there must still show the trust prompt (its hooks and settings run only after
    # that), whichever account the session is on. Every folder this dir knows is
    # held to it, so a trust revoked there, a folder dropped from it, or a grant left
    # by an older clx is cleared here too.
    src_projects = src.get("projects") or {}
    projects = dst.get("projects") or {}
    for path in set(projects) | set(src_projects):
        entry = src_projects.get(path) or {}
        merged = dict(projects.get(path) or {})
        if entry.get("hasTrustDialogAccepted") is True:
            merged["hasTrustDialogAccepted"] = True
        else:
            merged.pop("hasTrustDialogAccepted", None)
        for pkey in PROJECT_KEYS:
            if pkey in entry:
                merged[pkey] = copy.deepcopy(entry[pkey])
        projects[path] = merged
    dst["projects"] = projects

    write_json_atomic(dst_path, dst)
    report.append("prefs: %d keys + %d project paths -> %s" % (len(copied), len(projects), dst_path))
    return copied


def needs_init(directory):
    return not os.path.islink(os.path.join(directory, "settings.json"))


def is_claude_home(directory):
    """~/.claude itself, also when reached through a ~/.claude-<name> symlink."""
    try:
        return os.path.realpath(directory) == os.path.realpath(CLAUDE_HOME)
    except OSError:
        return False


def init_dirs(directories, quiet=False):
    copied = []
    for directory in directories:
        if is_claude_home(directory):
            # Linking ~/.claude's files to themselves makes each one a symlink loop
            # Claude Code cannot read: its settings, hooks and deny rules would be gone.
            if not quiet:
                print("== %s\n   skipped: it is ~/.claude itself" % directory)
            continue
        report = []
        ensure_links(directory, report)
        copied = merge_prefs(directory, report)
        if not quiet:
            print("== %s" % directory)
            for line in report:
                print("   " + line)
    return copied


def cmd_init(quiet=False):
    targets = [a.dir for a in discover() if not a.is_default]
    if not targets:
        print("clx --init: no ~/.claude-* account dirs with credentials yet")
        return 0
    init_dirs(targets, quiet=quiet)
    return 0


def auto_init(accounts):
    """Set up any account dir that has credentials but no shared profile yet."""
    pending = [a.dir for a in accounts
               if not a.is_default and not is_claude_home(a.dir) and needs_init(a.dir)]
    if pending:
        init_dirs(pending, quiet=True)
        warn("clx: initialised shared profile for %s" % ", ".join(os.path.basename(d) for d in pending))


